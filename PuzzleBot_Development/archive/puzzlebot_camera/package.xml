<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>puzzlebot_camera</name>
  <version>0.0.0</version>
  <description>Compressed camera launch with CycloneDDS for Puzzlebot</description>
  <maintainer email="elcrack50714@gmail.com">puzzlebot</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_deep_learning</exec_depend>
  <exec_depend>camera_info_publisher</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
