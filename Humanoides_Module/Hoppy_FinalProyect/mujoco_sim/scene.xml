<mujoco model="HOPPY scene">
  <!-- Scene = world (floor, light, sky) + the HOPPY robot.            -->
  <!-- Solver settings per rubrica Fase 3.1 (hard contact).            -->
  <include file="hoppy.xml"/>

  <option timestep="0.001" integrator="RK4" solver="Newton"
          iterations="50" tolerance="1e-8" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
    <map force="0.05" zfar="30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <light pos="1 -1 2.0" dir="-0.5 0.5 -1"/>
    <!-- floor at z=0; foot rest height ~0.044 m so it drops into contact -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          condim="3" friction="0.9 0.02 0.001"
          solref="0.004 1" solimp="0.95 0.99 0.001"/>
  </worldbody>
</mujoco>
